# 1. Install packages (only needed once)
install.packages(c("readxl", "readr"))
library(readxl)
library(readr)
# 2. CHANGE THIS to your folder path (use forward slashes /)
root <- "C:/Users/YourName/Downloads/YourFolderName"
# 3. Show columns and first rows of each key file
show <- function(path) {
full <- file.path(root, path)
cat("\n=====", path, "=====\n")
if (!file.exists(full)) { cat("FILE NOT FOUND\n"); return(invisible()) }
df <- if (grepl("\\.xlsx?$", full)) read_excel(full) else read_csv(full, show_col_types = FALSE)
cat("Rows:", nrow(df), " Cols:", ncol(df), "\n")
print(names(df))
print(head(df, 3))
}
files <- c(
"01_cleaned_data/lake_numeric_analysis.xlsx",
