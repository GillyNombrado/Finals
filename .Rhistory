# Check the path first
cat("Folders found:\n"); print(list.files(root))
for (f in c("01_cleaned_data", "02_training_candidate", "04_reference_tables")) {
cat("\n--- Files in", f, "---\n")
print(list.files(file.path(root, f)))
}
files <- c(
"01_cleaned_data/lake_numeric_analysis",
"01_cleaned_data/data_dictionary",
"02_training_candidate/train",
"02_training_candidate/test",
"04_reference_tables/fish_kill_events",
"04_reference_tables/gate_operating_rules",
"04_reference_tables/bay_flood_history",
"04_reference_tables/lake_monthly"
)
for (f in files) {
xlsx <- paste0(f, ".xlsx")
csv  <- paste0(f, ".csv")
if (file.exists(file.path(root, xlsx))) show(xlsx) else show(csv)
}
