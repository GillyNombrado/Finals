# Main statistical analysis

## RQ1: Lake level, rainfall and gate rules

```{r rq1}
m <- monthly %>% filter(!is.na(lake_level_mean_m), !is.na(rainfall_basin_average_mm)) %>%
  arrange(date) %>%
  mutate(rain_lag1 = lag(rainfall_basin_average_mm), level_change = lake_level_mean_m - lag(lake_level_mean_m))

cor.test(m$lake_level_mean_m, m$rainfall_basin_average_mm)
cor.test(m$lake_level_mean_m, m$rain_lag1)

summary(lm(level_change ~ rainfall_basin_average_mm + rain_lag1, data = m))

# Gate operating rules (reference table, shown for context)
gates %>% select(control_id, structure, regime_type, stage_or_condition, threshold_m, gates_total_open)
```

## RQ2: Which stations are at higher risk (crowding proxy)

No stocking or fish-pen data is in the cleaned folders, so RQ2 is answered with water-quality risk per station.

```{r rq2}
risk_table <- low_do_station %>% mutate(risk_class = case_when(
  pct_below_limit >= 15 ~ "High", pct_below_limit >= 5 ~ "Moderate", TRUE ~ "Low"))

# All 16 stations in one table (easy to screenshot)
knitr::kable(risk_table, digits = 2,
             caption = "Stations ranked by share of DO readings below the 6.5 mg/L screening level")

# Paired BOD vs DO correlation
paired <- lake_clean %>%
  select(station_id, date, param, numeric_value) %>%
  group_by(station_id, date, param) %>% summarise(v = mean(numeric_value), .groups = "drop") %>%
  pivot_wider(names_from = param, values_from = v) %>% drop_na(DO, BOD)
cor.test(paired$DO, paired$BOD)
```

## RQ3: Predicting next-month dissolved oxygen (risk of low DO)

Train on `train`, check on `validation`, final score on `test` (time-ordered splits from your files).

```{r rq3-prep}
feats <- c("do_t_mg_l", "do_t_minus_1_mg_l", "do_t_minus_2_mg_l", "bod_t_mg_l",
           "target_month_sin", "target_month_cos")
target <- "target_do_next_month_mg_l"

prep <- function(d) d %>% select(all_of(c(feats, target))) %>% drop_na()
tr <- prep(train); va <- prep(valid); te <- prep(test)

cat("Train:", nrow(tr), " Validation:", nrow(va), " Test:", nrow(te), "\n")
cat("Date ranges (target month):\n")
bind_rows(train = range(train$target_month), validation = range(valid$target_month),
          test = range(test$target_month)) %>% print()
```

```{r rq3-models}
metrics <- function(actual, pred) tibble(
  RMSE = sqrt(mean((actual - pred)^2)), MAE = mean(abs(actual - pred)),
  R2 = 1 - sum((actual - pred)^2) / sum((actual - mean(actual))^2))

# Baseline: next month = this month
base_pred <- te$do_t_mg_l
# Linear regression
lm_fit <- lm(as.formula(paste(target, "~ .")), data = tr)
lm_pred <- predict(lm_fit, te)
# Random forest
rf_fit <- randomForest(as.formula(paste(target, "~ .")), data = tr, ntree = 500)
rf_pred <- predict(rf_fit, te)

# Test set results
results <- bind_rows(
  Baseline_persistence = metrics(te[[target]], base_pred),
  Linear_regression    = metrics(te[[target]], lm_pred),
  Random_forest        = metrics(te[[target]], rf_pred),
  .id = "model")
knitr::kable(results, digits = 3, caption = "Table 1a. Test set (January 2024 to June 2026)")

# Validation set results
val_results <- bind_rows(
  Baseline_persistence = metrics(va[[target]], va$do_t_mg_l),
  Linear_regression    = metrics(va[[target]], predict(lm_fit, va)),
  Random_forest        = metrics(va[[target]], predict(rf_fit, va)),
  .id = "model")
knitr::kable(val_results, digits = 3, caption = "Table 1b. Validation set (2023)")

summary(lm_fit)
importance(rf_fit)

# Range of random forest predictions on the test set
range(rf_pred)
range(te[[target]])
```

```{r rq3-plot}
tibble(actual = te[[target]], predicted = rf_pred) %>%
  ggplot(aes(actual, predicted)) +
  geom_point(alpha = 0.5) + geom_abline(color = "red") +
  labs(title = "Random forest: actual vs predicted next-month DO (test set)",
       x = "Actual DO (mg/L)", y = "Predicted DO (mg/L)") +
  theme_minimal()
```

